{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email"]
    },
    "ChatSession": {
      "title": "ChatSession",
      "description": "A conversation session stored in Firestore",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "personaId": { "type": "string" },
        "timestamp": { "type": "number" },
        "messages": {
          "type": "array",
          "items": { "type": "object" }
        }
      },
      "required": ["id", "userId", "title", "timestamp"]
    },
    "Memory": {
      "title": "Memory",
      "description": "Persistent memory facts about the user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "content": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "userId", "content"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Stores user profiles"
    },
    "/users/{userId}/sessions/{sessionId}": {
      "schema": "ChatSession",
      "description": "Stores user chat sessions"
    },
    "/users/{userId}/memories/{memoryId}": {
      "schema": "Memory",
      "description": "Stores user memory facts"
    }
  }
}
